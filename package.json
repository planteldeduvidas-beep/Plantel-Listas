{
  "name": "plantel-listas",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do Plantel Listas",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "test:drive:write": "npm run test:drive:write --workspace backend",
    "db:create": "npm run db:create --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "classify:archive": "npm run classify:archive --workspace backend",
    "bootstrap:admin": "npm run bootstrap:admin --workspace backend",
    "check": "npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

