# Copie este arquivo para backend/.env no desenvolvimento local.
# Nunca versione valores reais ou segredos.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plantel_listas
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
CSRF_SECRET=
SESSION_DURATION_HOURS=168
PASSWORD_RESET_DURATION_MINUTES=30
SESSION_COOKIE_NAME=plantel_sessao
CSRF_COOKIE_NAME=plantel_csrf
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
RECOVERY_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=20
# Consultas da biblioteca por minuto e por usuario autenticado (nao limita streaming).
ACERVO_QUERY_RATE_LIMIT_MAX=120
# Camada ativa: migrations 018 e 019 obrigatorias antes de iniciar habilitada.
SECURITY_DEFENSE_ENABLED=true
# Gerar 32 bytes criptograficamente aleatorios (hexadecimal) no cofre/ambiente.
# Independente de CSRF_SECRET e GOOGLE_DRIVE_ENCRYPTION_KEY; nunca versionar o valor.
SECURITY_EVIDENCE_KEY=
SECURITY_WINDOW_MINUTES=10
SECURITY_SUSPECT_SCORE=10
SECURITY_LIMIT_SCORE=30
SECURITY_BLOCK_SCORE=60
SECURITY_ANONYMOUS_FACTOR=3
SECURITY_ENUMERATION_COUNT=12
SECURITY_PAUSE_SECONDS=30
SECURITY_BLOCK_MINUTES=15
SECURITY_REFRESH_SECONDS=5
SECURITY_ALERT_COOLDOWN_MINUTES=30
SECURITY_ALERT_HIGH_MAX=10
SECURITY_ALERT_CRITICAL_MAX=2
SECURITY_RETENTION_DAYS=30
SECURITY_EVENTS_PER_MINUTE=120
# Vazio usa SUPPORT_EMAIL_TO. Nunca aceita destinatario do navegador.
SECURITY_ALERT_EMAIL_TO=
SUPPORT_RATE_LIMIT_MAX=5
UPLOAD_MAX_PDF_MB=50
UPLOAD_MAX_VIDEO_MB=500
TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173

# SMTP opcional no desenvolvimento. Gmail exige verificacao em duas etapas e senha de app.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SUPPORT_EMAIL_TO=suporte@exemplo.com

# Eventos brutos sao consolidados antes de qualquer remocao pelo comando de manutencao.
ANALYTICS_RAW_RETENTION_DAYS=180
ANALYTICS_RETENTION_BATCH_SIZE=5000

# Somente para executar npm run bootstrap:admin. Nao mantenha preenchido depois.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# Google Drive OAuth 2.0 server-side. Nunca exponha estes valores no frontend.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_PASTA_RAIZ_ID=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integracoes/google-drive/oauth/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_ENCRYPTION_KEY=
GOOGLE_DRIVE_CHANGES_INTERVAL_MS=60000
CSRF_SECRET=
GOOGLE_DRIVE_ENCRYPTION_KEY=

