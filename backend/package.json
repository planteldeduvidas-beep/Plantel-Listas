    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "11.0.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.2",
    "nodemailer": "^9.0.5",
