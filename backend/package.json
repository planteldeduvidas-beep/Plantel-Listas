{
  "name": "@plantel-listas/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Plantel Listas",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
